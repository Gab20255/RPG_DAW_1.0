# ============================================
# Configuração do Projeto RPG Multiplayer
# ============================================
# Copie este arquivo para .env e preencha:
#   cp .env.example .env

# ── Opção 1: OpenRouter ──
# Crie sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Use o identificador de um modelo disponivel na sua conta.
# O custo depende do modelo/provedor escolhido.
# Exemplo DeepSeek com raciocinio desligado automaticamente:
# GEMINI_MODEL=deepseek/deepseek-v4-flash-0731
GEMINI_MODEL=google/gemini-2.5-flash

# ── Opção 2: Google AI Studio Direto ──
# Obtenha em: https://aistudio.google.com/apikey
# GEMINI_API_KEY=sua_chave_gemini_aqui
# GEMINI_MODEL=gemini-3.8-flash

# Porta do servidor (para o futuro Express)
PORT=3000

# Limite de resposta da geracao de mundo (ajuste conforme seu saldo/modelo)
WORLD_MAX_TOKENS=3000

# Limite das narracoes de resultados (nao afeta a criacao de personagem)
NARRATION_MAX_TOKENS=900

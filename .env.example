# ============================================
# Configuração do Projeto RPG Multiplayer
# ============================================
# Copie este arquivo para .env e preencha:
#   cp .env.example .env

# ── Opção 1: OpenRouter (Recomendado, modelos gratuitos e custo baixíssimo) ──
# Crie sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Modelos recomendados no OpenRouter:
#   google/gemini-2.5-flash:free     (Totalmente grátis)
#   meta-llama/llama-3.3-70b-instruct:free (Grátis e muito bom para RPG)
#   google/gemini-2.5-flash           (Centavos por milhão de tokens)
GEMINI_MODEL=google/gemini-2.5-flash:free

# ── Opção 2: Google AI Studio Direto ──
# Obtenha em: https://aistudio.google.com/apikey
# GEMINI_API_KEY=sua_chave_gemini_aqui
# GEMINI_MODEL=gemini-3.8-flash

# Porta do servidor (para o futuro Express)
PORT=3000

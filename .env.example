# ============================================
# Configuração do Projeto RPG Multiplayer
# ============================================
# Copie este arquivo para .env e preencha:
#   cp .env.example .env

# ── Opção 1: OpenRouter ──
# Crie sua chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Use o identificador de um modelo disponivel na sua conta.
# O custo depende do modelo/provedor escolhido.
# Exemplo DeepSeek com raciocinio desligado automaticamente:
GEMINI_MODEL=deepseek/deepseek-v4-flash

# ── Opção 2: Google AI Studio Direto ──
# Obtenha em: https://aistudio.google.com/apikey
# GEMINI_API_KEY=sua_chave_gemini_aqui
# GEMINI_MODEL=gemini-3.8-flash

# API local: npm start -- --api
PORT=3000
DATABASE_PATH=database/rpg.db

# O /novo usa ate 120 tokens na selecao e 1600 na adaptacao, independente destes limites.
# Limite da geracao antiga por agentes (/retomar e /expandir)
WORLD_MAX_TOKENS=10000

# Limites de cada especialista e da revisao final, nao do mundo inteiro
AGENT_MAX_TOKENS=10000
REVIEW_MAX_TOKENS=10000
GENERATION_CONCURRENCY=6

# Limite das narracoes de resultados (nao afeta a criacao de personagem)
NARRATION_MAX_TOKENS=1600

# Mestre progressivo: saida por cena, entre 1200 e 4000 tokens
MASTER_MAX_TOKENS=2400

ENRICHMENT_MAX_TOKENS=10000
